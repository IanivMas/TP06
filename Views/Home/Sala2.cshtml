@{
    ViewData["Title"] = "Nivel 2 - Sala de Escape";
}

<div class="room-shell">
    <div class="room-card">
        <div class="room-header">
            <span class="room-label">Nivel 2</span>
            <h1 class="room-title">🔐 La memoria correcta</h1>
        </div>

        <div class="room-content">
            <div class="room-section">
                <h2>Historia</h2>
                <p>En la siguiente habitación hay una PC con estas características:</p>
                <p>La computadora tiene 8 GB de RAM, pero necesita ejecutar varios programas al mismo tiempo.</p>
            </div>

            <div class="room-section">
                <h2>Módulos disponibles</h2>
                <ul>
                    <li>4 GB</li>
                    <li>8 GB</li>
                    <li>16 GB</li>
                </ul>
            </div>

            <div class="room-section">
                <h2>El Desafío</h2>
                <p>Se necesita llegar a 16 GB de RAM usando un solo módulo adicional.</p>

                <h2>La Pregunta</h2>
                <p>¿Qué módulo tenés que colocar?</p>
               <form action="@Url.Action("ComprobarRespuesta", "Home")" method="post">
    <input type="hidden" name="ID" value="2">

    <input type="text" name="respuesta" class="room-input" placeholder="Escribe tu respuesta aquí">

    <div class="room-actions">
        <button type="submit" class="room-button">Verificar Respuesta</button>
    </div>
</form>

            </div>

            <p class="room-tip">Pista: Debes sumar el módulo que coloques a los 8 GB que ya tienes.</p>
        </div>

        <a class="room-back" href="@Url.Action("PaginaPrincipal", "Home")">← Volver a la página principal</a>
    </div>
</div>
