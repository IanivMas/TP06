@{
    ViewData["Title"] = "Nivel 1 - Sala de Escape";
}

<div class="room-shell">
    <div class="room-card">
        <div class="room-header">
            <span class="room-label">Nivel 1</span>
            <h1 class="room-title">🔐 ¿Qué componente falta?</h1>
        </div>

        <div class="room-content">
            <div class="room-section">
                <h2>Historia</h2>
                <p>El jugador entra a la primera habitación y encuentra una PC que no puede arrancar.</p>
                <p>Hay una lista de componentes que debería tener:</p>

                <ul>
                    <li>Procesador</li>
                    <li>RAM</li>
                    <li>Placa madre</li>
                    <li>Fuente de alimentación</li>
                    <li>Monitor</li>
                </ul>
            </div>

            <div class="room-section">
                <h2>El Problema</h2>
                <p>Pero falta un componente fundamental para almacenar permanentemente el sistema operativo y los archivos.</p>
            </div>

            <div class="room-section">
                <h2>El Desafío</h2>
                <p>¿Qué componente falta?</p>

                <input type="text" class="room-input" placeholder="Escribe tu respuesta aquí">
                <div class="room-actions">
                    <button class="room-button">Verificar Respuesta</button>
                </div>
            </div>

            <p class="room-tip">Pista: Sin este componente, no hay lugar donde guardar tus datos de forma permanente.</p>
        </div>

        <a class="room-back" href="@Url.Action("PaginaPrincipal", "Home")">← Volver a la página principal</a>
    </div>
</div>
