@{
    ViewData["Title"] = "Nivel 3 - Sala de Escape";
}

<div class="room-shell">
    <div class="room-card">
        <div class="room-header">
            <span class="room-label">Nivel 3</span>
            <h1 class="room-title">🔐 ¿Qué conector es?</h1>
        </div>

        <div class="room-content">
            <div class="room-section">
                <h2>Historia</h2>
                <p>En esta habitación hay varios conectores disponibles en la pared.</p>
            </div>

            <div class="room-section">
                <h2>Conectores disponibles</h2>
                <ul>
                    <li>USB</li>
                    <li>HDMI</li>
                    <li>Ethernet</li>
                    <li>VGA</li>
                </ul>
            </div>

            <div class="room-section">
                <h2>La Pista</h2>
                <p>Necesitás conectar la computadora a Internet mediante un cable de red.</p>

                <h2>La Pregunta</h2>
                <p>¿Qué conector tenés que utilizar?</p>
               <form action="@Url.Action("ComprobarRespuesta", "Home")" method="post">
    <input type="hidden" name="ID" value="3">

    <input type="text" name="respuesta" class="room-input" placeholder="Escribe tu respuesta aquí">

    <div class="room-actions">
        <button type="submit" class="room-button">Verificar Respuesta</button>
    </div>
</form>
            </div>

            <p class="room-tip">Pista adicional: Este conector es específico para conexiones de red con cable.</p>
        </div>
    </div>
</div>

<a class="room-back" href="@Url.Action("PaginaPrincipal", "Home")">← Volver a la página principal</a>
